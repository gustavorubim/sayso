{
  "name": "sayso",
  "version": "0.4.0",
  "description": "Hold a shortcut, speak, and the text lands where your cursor is. Local speech-to-text with models from Hugging Face.",
  "main": "./out/main/index.js",
  "author": "gustavorubim <gustavorubim@users.noreply.github.com>",
  "license": "MIT",
  "homepage": "https://github.com/gustavorubim/sayso",
  "repository": {
    "type": "git",
    "url": "https://github.com/gustavorubim/sayso.git"
  },
  "scripts": {
    "core:build": "cargo build --manifest-path core/Cargo.toml",
    "core:release": "cargo build --release --manifest-path core/Cargo.toml",
    "core:test": "cargo test --manifest-path core/Cargo.toml",
    "dev": "npm run core:build && electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "icons": "node scripts/make-icons.mjs",
    "dist": "npm run core:release && npm run build && electron-builder --publish never",
    "release": "npm run core:release && npm run build && electron-builder --publish always",
    "version:set": "node scripts/set-version.mjs",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test",
    "pack:dir": "npm run core:release && npm run build && electron-builder --dir --publish never",
    "smoke": "node scripts/smoke-test.mjs"
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/fredoka": "^5.3.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.10.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
